rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /baby-bets/{doc} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }
    match /prode-admin/{doc} {
      allow read: if true;
      allow write: if true;
    }
  }
}
